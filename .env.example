# =============================================================
# Aisha AI — Configuration
# Copy this file to .env and fill in your keys.
# Do NOT commit .env to version control — it contains secrets.
# =============================================================

# -------------------------------------------------------------
# Primary AI Provider (fast — simple tasks, app opens, timers)
# Used for: quick commands, wake-word responses, simple tasks
# Recommended: Groq (fastest), NVIDIA NIM, or any OpenAI-compatible API
# -------------------------------------------------------------
BASE_URL="https://api.groq.com/openai/v1"
TOKEN="your_primary_api_key_here"
AISHA_PRIMARY_MODEL="openai/gpt-oss-20b"
AISHA_MODEL_CASCADE="openai/gpt-oss-20b,openai/gpt-oss-120b,/"
AISHA_MAX_TOKENS="1600"
AISHA_MAX_STEPS="16"

# -------------------------------------------------------------
# NVIDIA NIM (fallback — used when primary is rate-limited/down)
# Get your free key at: https://build.nvidia.com/
# -------------------------------------------------------------
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY="your_nvidia_key_here"
NVIDIA_MODELS="nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-30b-a3b"
NVIDIA_MODEL_CASCADE=""

# -------------------------------------------------------------
# AgentRouter (secondary failsafe — deep backup)
# Free tier available. Sign up at: https://agentrouter.org/
# -------------------------------------------------------------
AGENTROUTER_BASE_URL="https://agentrouter.org"
AGENTROUTER_TOKEN="your_agentrouter_key_here"
AGENTROUTER_MODELS="deepseek-v4-flash,,claude-opus-4-8,claude-opus-5"

# -------------------------------------------------------------
# Bay of Assets (strong AI — research, writing, complex chains)
# OpenAI-compatible (Claude / GPT / Gemini). Multi-step and
# content-heavy tasks route here for the strongest reasoning.
# Sign up at: https://bayofassets.com
# -------------------------------------------------------------
BAYOFASSETS_BASE_URL="https://api.bayofassets.com/v1"
BAYOFASSETS_TOKEN="your_bayofassets_key_here"
BAYOFASSETS_MODEL="claude-opus-4-8"
BAYOFASSETS_MODELS="claude-opus-4-8,claude-sonnet-5"
BAYOFASSETS_VISION_MODEL="claude-sonnet-5"

# -------------------------------------------------------------
# File output — where Aisha saves everything she creates
# (documents, presentations, spreadsheets). One fixed folder
# so nothing is ever lost or scattered. Change the path if you like.
# -------------------------------------------------------------
AISHA_OUTPUT_DIR="E:\AishaFiles"

# -------------------------------------------------------------
# Voice & Microphone Settings
# Leave ELEVEN_LAB blank to use Windows TTS fallback (no key needed).
# Get ElevenLabs key at: https://elevenlabs.io/ (free tier: 10K chars/month)
# -------------------------------------------------------------
ELEVEN_LAB="your_elevenlabs_key_here"
ELEVENLABS_VOICE_ID="WUgmmuDCpFXQ4z0NUUYX"
ELEVENLABS_MODEL_ID="eleven_v3"
WHISPER_MODEL="small"

# -------------------------------------------------------------
# Optional: Email (for send_email tool)
# Uses SMTP. For Gmail, use an App Password (not your login password).
# -------------------------------------------------------------
EMAIL_USER="your_email@gmail.com"
EMAIL_PASSWORD="your_app_password"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"

# -------------------------------------------------------------
# Advanced (usually no need to change these)
# -------------------------------------------------------------
# AISHA_DATA_DIR=".assistant_data"
# AISHA_API_TYPE="openai"  # Set if your primary provider needs OpenAI client instead of Anthropic
